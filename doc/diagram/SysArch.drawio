        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n    %% Users\n    U[Customer / User]\n    A[Admin]\n    O[Event Organizer]\n\n    %% Frontend\n    FE[Frontend&lt;br/&gt;HTML / CSS / JavaScript]\n\n    %% Backend\n    API[Spring Boot REST API]\n\n    %% Security\n    SEC[Authentication &amp; Authorization&lt;br/&gt;Spring Security]\n\n    %% Controllers\n    C1[User Controller]\n    C2[Event Controller]\n    C3[Booking Controller]\n    C4[Seat Controller]\n    C5[Payment Controller]\n    C6[Admin Controller]\n    C7[Ticket Controller]\n\n    %% Services\n    S1[User Service]\n    S2[Event Service]\n    S3[Booking Service]\n    S4[Seat Service]\n    S5[Payment Service]\n    S6[Ticket Service]\n    S7[Admin Service]\n\n    %% Database\n    DB[(MySQL Database)]\n\n    %% Tables\n    T1[(User)]\n    T2[(Admin)]\n    T3[(Event)]\n    T4[(Venue)]\n    T5[(Seat)]\n    T6[(Booking)]\n    T7[(Ticket)]\n    T8[(Payment)]\n\n    %% User interactions\n    U --&gt; FE\n    A --&gt; FE\n    O --&gt; FE\n\n    FE --&gt; API\n\n    %% Security\n    API --&gt; SEC\n\n    %% Controllers\n    API --&gt; C1\n    API --&gt; C2\n    API --&gt; C3\n    API --&gt; C4\n    API --&gt; C5\n    API --&gt; C6\n    API --&gt; C7\n\n    %% Controller to Service\n    C1 --&gt; S1\n    C2 --&gt; S2\n    C3 --&gt; S3\n    C4 --&gt; S4\n    C5 --&gt; S5\n    C6 --&gt; S7\n    C7 --&gt; S6\n\n    %% Services to Database\n    S1 --&gt; DB\n    S2 --&gt; DB\n    S3 --&gt; DB\n    S4 --&gt; DB\n    S5 --&gt; DB\n    S6 --&gt; DB\n    S7 --&gt; DB\n\n    %% Database tables\n    DB --&gt; T1\n    DB --&gt; T2\n    DB --&gt; T3\n    DB --&gt; T4\n    DB --&gt; T5\n    DB --&gt; T6\n    DB --&gt; T7\n    DB --&gt; T8\n\n    %% Relationships\n    T1 -.-&gt; T6\n    T3 -.-&gt; T4\n    T4 -.-&gt; T5\n    T3 -.-&gt; T6\n    T5 -.-&gt; T6\n    T6 -.-&gt; T7\n    T6 -.-&gt; T8&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="L8fucG2VS8aDuH-OMP0t-1">
